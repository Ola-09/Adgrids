# ADGRID Cloud — environment template
# Copy to .env and fill in real values. NEVER commit .env itself.

# Auth
JWT_ACCESS_SECRET="change-me-strong-access-secret"
JWT_REFRESH_SECRET="change-me-strong-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Media storage (drivers: local | cloudinary)
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"
# CLOUDINARY_URL="cloudinary://key:secret@cloud"

# Booking engine
BOOKING_DEPOSIT_PERCENT="50"

# Payment gateways (webhook signature verification)
# PAYSTACK_SECRET_KEY="sk_test_..."
# FLUTTERWAVE_SECRET_HASH="..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
